<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Shared/Button.uss?fileID=7433441132597879392&amp;guid=6d23cb732104f1f46931923e74a6d700&amp;type=3#Button"/>
    <Style src="project://database/Assets/UI/Building/BuildingUI.uss?fileID=7433441132597879392&amp;guid=ac8d39037fc94366b11e410c84009581&amp;type=3#BuildingUI"/>
    <ui:VisualElement name="root" class="root">
        <ui:VisualElement name="bottom-button-container" class="bottom-button-container">
            <ui:Button name="construction-mode-button" text="건설 모드" class="bottom-button blocking-ui"/>
            <ui:Button name="research-button" text="연구" class="bottom-button blocking-ui"/>
        </ui:VisualElement>
        <ui:VisualElement name="research-panel-root" class="research-panel-root blocking-ui" picking-mode="Position" style="display: none;">
            <ui:VisualElement class="research-panel">
                <ui:VisualElement class="header-row">
                    <ui:Label text="연구" class="building-title"/>
                    <ui:Button name="research-close-button" text="×" class="close-button"/>
                </ui:VisualElement>
                <ui:Label name="research-active-label" text="진행 중 연구: 없음" class="research-summary-label"/>
                <ui:Label name="research-building-count-label" text="작동 가능한 연구건물: 0개" class="research-summary-label"/>
                <ui:VisualElement class="research-body">
                    <ui:VisualElement class="research-list-panel">
                        <ui:Label text="연구 가능한 목록" class="section-title"/>
                        <ui:Label name="research-list-empty" text="현재 연구 가능한 항목이 없습니다." class="research-detail"/>
                        <ui:ScrollView name="research-available-list" class="research-list-scroll" horizontal-scroller-visibility="Hidden"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="research-detail-panel">
                        <ui:Label name="research-inspected-label" text="연구를 선택하세요" class="section-title"/>
                        <ui:Label name="research-inspected-description" class="research-detail"/>
                        <ui:Button name="research-start-button" text="연구 시작" class="research-start-button"/>
                        <ui:Label text="목록에서 선택한 연구의 후속 경로 · 노드를 클릭하면 배치를 유지하고 상세 정보를 표시합니다." class="research-detail"/>
                        <ui:ScrollView name="research-tree-scroll" mode="VerticalAndHorizontal" class="research-tree-scroll" horizontal-scroller-visibility="Auto" vertical-scroller-visibility="Auto">
                            <ui:VisualElement name="research-tree-canvas" class="research-tree-canvas"/>
                        </ui:ScrollView>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="building-ui-root" class="building-ui-root" picking-mode="Ignore">
            <ui:VisualElement name="building-panel" class="building-panel blocking-ui" picking-mode="Position" style="display: none;">
                <ui:VisualElement class="header-row">
                    <ui:Label name="building-title" text="제작기" class="building-title"/>
                    <ui:Button name="close-button" text="×" class="close-button"/>
                </ui:VisualElement>
                <ui:Label name="building-status" text="레시피를 선택하세요" class="status-label status-waiting"/>
                <ui:ScrollView class="content-scroll">
                    <ui:VisualElement name="power-container" class="power-container">
                        <ui:Label name="power-title" text="전력" class="section-title"/>
                        <ui:Label name="power-grid" class="power-information-label"/>
                        <ui:Label name="power-primary" class="power-information-label"/>
                        <ui:Label name="power-secondary" class="power-information-label"/>
                        <ui:Label name="power-tertiary" class="power-information-label"/>
                        <ui:Label name="power-quaternary" class="power-information-label"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="drone-container" class="drone-container" style="display: none;">
                        <ui:Label text="배터리" class="section-title"/>
                        <ui:ProgressBar name="drone-battery-progress" low-value="0" high-value="100" value="0" title="0%" class="drone-battery-progress"/>
                        <ui:Label name="drone-battery" class="drone-information-label"/>
                        <ui:Label text="운행 정보" class="section-title"/>
                        <ui:Label name="drone-cargo" class="drone-information-label"/>
                        <ui:Label name="drone-capability" class="drone-information-label"/>
                        <ui:Label name="drone-task" class="drone-information-label"/>
                        <ui:Label name="drone-assignment" class="drone-information-label"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="belt-container" class="belt-container" style="display: none;">
                        <ui:Label text="이동 성능" class="section-title"/>
                        <ui:Label name="belt-maximum-speed" class="belt-information-label"/>
                        <ui:Label text="벨트 위 아이템" class="section-title"/>
                        <ui:VisualElement name="belt-item-container" class="belt-item-container"/>
                    </ui:VisualElement>
                    <ui:Label name="recipe-title" text="레시피" class="section-title"/>
                    <ui:Label name="current-recipe" text="현재 레시피: 없음" class="current-recipe"/>
                    <ui:VisualElement name="recipe-container" class="recipe-container"/>
                    <ui:Label name="dedicated-drone-storage-title" text="보관 드론" class="section-title" style="display: none;"/>
                    <ui:VisualElement name="dedicated-drone-storage-container" class="inventory-container storage-grid dedicated-drone-storage-grid" style="display: none;"/>
                    <ui:Label name="input-title" text="투입 아이템" class="section-title"/>
                    <ui:VisualElement name="input-container" class="inventory-container"/>
                    <ui:VisualElement name="drone-transfer-container" class="drone-transfer-container">
                        <ui:Label text="드론 일회성 운송" class="section-title"/>
                        <ui:DropdownField name="drone-item" label="아이템" class="drone-transfer-field"/>
                        <ui:IntegerField name="drone-quantity" label="수량" value="1" class="drone-transfer-field"/>
                        <ui:VisualElement class="drone-transfer-buttons">
                            <ui:Button name="drone-insert-button" text="넣기 요청" class="drone-transfer-button"/>
                            <ui:Button name="drone-remove-button" text="꺼내기 요청" class="drone-transfer-button"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Label name="output-title" text="생산 대기 아이템" class="section-title"/>
                    <ui:VisualElement name="output-container" class="inventory-container"/>
                    <ui:Label name="progress-title" text="생산 진행도" class="section-title"/>
                    <ui:ProgressBar name="production-progress" low-value="0" high-value="100" value="0" title="0%" class="production-progress"/>
                    <ui:Label name="remaining-time" text="생산 대기" class="information-label"/>
                    <ui:Label name="production-speed" text="생산 속도: ×1" class="information-label speed-label"/>
                    <ui:Label name="production-speed-reason" text="속도 변경 이유: 전력 정상 공급" class="information-label speed-reason-label"/>
                </ui:ScrollView>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
