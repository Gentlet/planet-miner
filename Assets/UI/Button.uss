.root {
    width: 100%;
    height: 100%;
}

.bottom-button-container {
    position: absolute;
    bottom: 30px;
    left: 0;
    right: 0;

    flex-direction: row;
    justify-content: center;
    align-items: center;

    gap: 20px;
}

.bottom-button {
    width: 160px;
    height: 60px;

    font-size: 22px;
}

.bottom-button.selected {
    background-color: rgb(62, 118, 164);
    border-top-color: rgb(132, 203, 255);
    border-right-color: rgb(132, 203, 255);
    border-bottom-color: rgb(132, 203, 255);
    border-left-color: rgb(132, 203, 255);
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
}

.construction-guide {
    position: absolute;
    top: 24px;
    left: 24px;
    max-width: 760px;

    padding: 12px 16px;
    background-color: rgba(10, 20, 30, 0.82);
    border-radius: 6px;
}

.construction-guide-title {
    margin-bottom: 6px;
    color: rgb(240, 248, 255);
    font-size: 18px;
    -unity-font-style: bold;
}

.construction-guide-text {
    margin-top: 2px;
    color: rgb(210, 224, 236);
    font-size: 15px;
    white-space: normal;
}

.copy-status {
    position: absolute;
    top: 24px;
    left: 50%;
    translate: -50% 0;

    padding: 10px 16px;
    color: rgb(240, 248, 255);
    background-color: rgba(10, 20, 30, 0.82);
    border-radius: 6px;
    font-size: 18px;
}
