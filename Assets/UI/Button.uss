.root {
    width: 100%;
    height: 100%;
}

.bottom-button-container {
    position: absolute;
    bottom: 30px;
    left: 0;
    right: 0;

    flex-direction: row;
    justify-content: center;
    align-items: center;

    gap: 20px;
}

.bottom-button {
    width: 160px;
    height: 60px;

    font-size: 22px;
}

.copy-status {
    position: absolute;
    top: 24px;
    left: 50%;
    translate: -50% 0;

    padding: 10px 16px;
    color: rgb(240, 248, 255);
    background-color: rgba(10, 20, 30, 0.82);
    border-radius: 6px;
    font-size: 18px;
}
