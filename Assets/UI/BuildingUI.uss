.building-ui-root {
    width: 100%;
    height: 100%;
}

.building-panel {
    position: absolute;
    top: 24px;
    right: 24px;
    bottom: 24px;
    width: 430px;
    padding: 18px;
    background-color: rgba(20, 25, 34, 0.96);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(73, 91, 116);
    border-right-color: rgb(73, 91, 116);
    border-top-color: rgb(73, 91, 116);
    border-bottom-color: rgb(73, 91, 116);
    color: rgb(232, 237, 245);
}

.header-row {
    height: 48px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.building-title {
    font-size: 28px;
    -unity-font-style: bold;
}

.close-button {
    width: 44px;
    height: 40px;
    font-size: 26px;
    background-color: rgb(54, 63, 77);
    color: rgb(238, 241, 246);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.status-label {
    min-height: 42px;
    margin-top: 8px;
    margin-bottom: 10px;
    padding: 10px;
    font-size: 16px;
    white-space: normal;
    background-color: rgb(43, 49, 60);
}

.status-normal {
    color: rgb(122, 226, 154);
}

.status-waiting {
    color: rgb(243, 204, 103);
}

.status-error {
    color: rgb(255, 126, 126);
}

.content-scroll {
    flex-grow: 1;
}

.section-title {
    margin-top: 18px;
    margin-bottom: 8px;
    padding-bottom: 5px;
    font-size: 19px;
    -unity-font-style: bold;
    border-bottom-width: 1px;
    border-bottom-color: rgb(76, 88, 106);
}

.current-recipe {
    margin-bottom: 8px;
    color: rgb(185, 202, 226);
    font-size: 16px;
}

.recipe-container {
    flex-direction: row;
    flex-wrap: wrap;
}

.recipe-button {
    width: 184px;
    min-height: 72px;
    margin-right: 8px;
    margin-bottom: 8px;
    padding: 8px;
    white-space: normal;
    font-size: 14px;
    background-color: rgb(48, 58, 73);
    color: rgb(225, 231, 240);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(66, 80, 101);
    border-right-color: rgb(66, 80, 101);
    border-top-color: rgb(66, 80, 101);
    border-bottom-color: rgb(66, 80, 101);
}

.recipe-button-selected {
    background-color: rgb(43, 94, 111);
    border-left-color: rgb(86, 208, 224);
    border-right-color: rgb(86, 208, 224);
    border-top-color: rgb(86, 208, 224);
    border-bottom-color: rgb(86, 208, 224);
}

.inventory-container {
    margin-bottom: 4px;
}

.item-row {
    min-height: 48px;
    margin-bottom: 6px;
    padding-left: 10px;
    padding-right: 10px;
    flex-direction: row;
    align-items: center;
    background-color: rgb(40, 47, 59);
    border-left-width: 3px;
    border-left-color: rgb(81, 104, 137);
}

.item-row-exception {
    background-color: rgb(71, 42, 45);
    border-left-color: rgb(239, 103, 103);
}

.item-name {
    width: 100px;
    font-size: 15px;
    -unity-font-style: bold;
}

.item-count {
    width: 68px;
    font-size: 15px;
    color: rgb(193, 211, 236);
}

.item-detail {
    flex-grow: 1;
    font-size: 13px;
    white-space: normal;
    color: rgb(173, 183, 199);
}

.empty-label {
    height: 38px;
    padding: 9px;
    color: rgb(132, 143, 160);
    background-color: rgb(36, 42, 52);
}

.production-progress {
    height: 30px;
    margin-top: 4px;
    margin-bottom: 8px;
}

.information-label {
    margin-top: 4px;
    font-size: 15px;
    color: rgb(194, 205, 220);
}

.speed-label {
    margin-bottom: 20px;
}
